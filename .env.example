# =============================================================================
# Bot Sniper Solana — variáveis de ambiente
#
# ATENÇÃO: nenhum segredo deve ser commitado. Este arquivo é apenas o TEMPLATE.
# Copie para `.env` (que deve estar no .gitignore) e preencha.
#
# REGRA DE OURO: comece SEMPRE com RUNTIME_MODE=PAPER (ou ausente) e
# LIVE_TRADING_ENABLED ausente/false.
#
# MODOS DE EXECUÇÃO (RUNTIME_MODE) — definem quem pode assinar transação:
#   SIMULATION  dados sintéticos (ÚNICO modo onde RNG é legítimo). Nunca assina.
#   PAPER       dados reais, contabilidade modelada. Nunca assina. (default)
#   SHADOW      dados reais, constrói e SIMULA a transação, nunca assina.
#   LIVE        único modo autorizado a assinar/enviar.
#
# LIVE exige DUAS declarações: RUNTIME_MODE=LIVE **e** LIVE_TRADING_ENABLED=true.
#   - RUNTIME_MODE=LIVE sem a flag  -> rebaixado para SHADOW (não assina).
#   - LIVE_TRADING_ENABLED=true sem RUNTIME_MODE -> ERRO FATAL NO BOOT (não sobe ambíguo).
# Em LIVE, o boot também exige OPERATIONAL_PRIVATE_KEY, ADMIN_TOKEN e RPC_ENDPOINT https.
# =============================================================================

# -----------------------------------------------------------------------------
# MODO DE EXECUÇÃO
# -----------------------------------------------------------------------------
# Valores: SIMULATION | PAPER | SHADOW | LIVE. Ausente = PAPER.
RUNTIME_MODE=PAPER

# Host de bind do servidor HTTP. Ausente = 127.0.0.1 (loopback).
# Expor na rede é decisão explícita: com chave real presente, o boot passa a exigir
# ADMIN_TOKEN quando este valor NÃO for loopback.
HFT_BIND_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# REDE / RPC  (obrigatório para operar)
# -----------------------------------------------------------------------------
# RPC dedicado. NÃO use https://api.mainnet-beta.solana.com para trading:
# é rate-limited agressivamente, não garante envio e não tem suporte.
RPC_ENDPOINT=
# WebSocket correspondente (wss://...). Sem ele, não há detecção de lançamentos.
RPC_WEBSOCKET=
# Backups separados por vírgula (failover). Ex.: https://b.example.com,https://c.example.com
RPC_FALLBACKS=
# Perfil de cota do RPC (camada gratuita): public | helius | alchemy | quicknode | syndica.
# Escolhe o teto de chamadas por segundo usado pelo orçamento (src/rateBudget.ts). Errado para
# menos = o bot se limita demais e pula decisões; errado para mais = 429 no meio da rajada.
# Plano gratuito completo: ver GRATIS.md e medir com `npm run free:check`.
HFT_RPC_PROFILE=public

# ── ENTRADA REAL (S6) ────────────────────────────────────────────────────────
# TRÊS declarações são necessárias para entrada real: RUNTIME_MODE=LIVE +
# LIVE_TRADING_ENABLED=true + HFT_REAL_ENTRY_ENABLED=1. As duas primeiras já existem
# acima; esta é específica de ENTRADA (o caminho de SAÍDA não depende dela).
#
# O default (comentado) é DESLIGADO de propósito: o bot roda em PAPER/SHADOW sem capital.
# HFT_REAL_ENTRY_ENABLED=1
# HFT_AUTONOMOUS_ENTRY=1        # entrada pelo pipeline automático (sem isto: só POST /api/real-entry)
# HFT_CANARY_MAX_SOL=0.01       # TETO DURO por entrada — inclusive na primeira. 0,01 SOL = canário.
# HFT_CANARY_ONE_ENTRY=1        # depois da primeira entrada real, para até análise explícita
# HFT_ENTRY_SLIPPAGE_BPS=300    # 3% — vai NA INSTRUÇÃO (a AMM rejeita fora da banda)
# HFT_ENTRY_MAX_PRICE_IMPACT_BPS=1500  # 15% de impacto: acima disto a entrada é recusada
# HFT_ENTRY_REQUIRE_PREFLIGHT=1 # simulação obrigatória antes de assinar (default)
# MAX_TOTAL_EXPOSURE_SOL=0      # 0 = sem limite declarado; em LIVE, declare um valor

# ROTA DE ENTRADA. `aggregator` (default) usa Jupiter: exige rota existente para o mint.
# `native` monta a instrução `buy_exact_sol_in` do IDL PÚBLICO pinado em
# assets/pump-idl-excerpt.json — sem round-trip de agregador, mas o layout tem de ser
# validado contra a rede ANTES:  npm run pump:dryrun -- <mint> --payer <sua_chave_PUBLICA>
# (o dry-run não assina e não envia nada; verdict esperado: err: null).
# HFT_ENTRY_ROUTE=aggregator
# HFT_ENTRY_CU_LIMIT=200000               # teto de compute units da compra na curva
# HFT_ENTRY_CU_PRICE_MICROLAMPORTS=0      # priority fee por CU; 0 = não define (só o tip Jito)

# ── INGESTÃO (S7) ────────────────────────────────────────────────────────────
# O WebSocket do RPC assina os 4 programas (Raydium/CPMM/pump/Meteora) e continua ativo SEMPRE.
# O fast path gRPC (Yellowstone) é ADITIVO: assina TRANSAÇÕES do pump em `processed`, e o mint vem
# do CreateEvent do próprio stream — sem espera de `confirmed` e sem getTransaction por lançamento.
# Valide no SEU ambiente antes de ligar:  npm run grpc:check -- --seconds 30
# HFT_INGEST=auto                         # auto (grpc quando houver endpoint) | grpc | wss
# GEYSER_GRPC_URL=grpc.seu-provedor.com:443   # host:porta, SEM esquema de URL
# GEYSER_GRPC_TOKEN=                        # segredo: nunca aparece em log (há teste que garante)
# HFT_GRPC_PING_MS=15000                  # keep-alive do stream (provedor encerra stream ocioso)
# HFT_GRPC_MAX_RECONNECTS=0               # 0 = reconectar sempre; >0 = desistir e ficar no WSS

# ── ENVIO (S8) ───────────────────────────────────────────────────────────────
# Os MESMOS bytes assinados entregues por vários caminhos ao mesmo tempo: o primeiro aceite vence e
# os perdedores NÃO são cancelados (um deles pode ser o que entra no próximo bloco). Não há risco de
# duplicar a operação: mesma assinatura = mesma transação; quem duplicaria é assinar duas vezes, e
# isso o sistema de intenções bloqueia ANTES de assinar. Default: desligado (só bundle Jito).
# HFT_PARALLEL_SEND=0                     # 1 = habilita a corrida de transportes
# HFT_STAKED_SENDER_URL=                  # endpoint de envio com stake/SWQOS DO SEU PROVEDOR
# HFT_STAKED_SWQOS_ONLY=1                 # envia com ?swqos_only=true (o provedor pode exigir tip mínimo)
# HFT_SEND_RPC_DIRECT=0                   # 1 = envia também pelo RPC de leitura (consome cota de envio)
# HFT_TRANSPORT_TIMEOUT_MS=3000           # timeout por transporte (piso 250ms, teto 30s)
# S13 — se o block engine do Jito RECUSAR, os MESMOS bytes assinados vão pelo RPC (default 1).
# Não duplica a ordem (a assinatura identifica a transação) e custa cota de ENVIO do RPC —
# paga só quando o Jito falha. 0 = recusa do Jito vira falha terminal da tentativa: com um
# provider que aplica rate limit, uma SAÍDA pode ficar presa no token.
# HFT_RPC_FALLBACK_ON_JITO_FAIL=1
# Desliga os orçamentos (diagnóstico). Em plano gratuito isto troca uma falha previsível
# (chamada pulada e contada) por 429 no meio de um lançamento. Contadores seguem ativos.
HFT_BUDGET_DISABLED=0
# Rótulos exibidos no painel de infraestrutura (opcionais).
RPC_PRIMARY_LABEL=
RPC_PRIMARY_REGION=

# Grafo de ingestão gRPC (Yellowstone). Se vazio, cai para WebSocket RPC, que tem
# latência maior. OBS.: o cliente protobuf gRPC ainda NÃO está implementado neste
# código — configurar aqui hoje apenas registra um aviso no boot.
GEYSER_GRPC_URL=

# -----------------------------------------------------------------------------
# DETECÇÃO GRATUITA (PumpPortal) E EVIDÊNCIA EXTERNA (RugCheck)
# -----------------------------------------------------------------------------
# Feed da PumpPortal: subscribeNewToken/subscribeMigration são GRÁTIS e sem chave, e entregam o
# endereço do MINT na própria notificação — este caminho não paga `getTransaction` nem a espera
# até `confirmed`. Fonte ADICIONAL: o logsSubscribe do RPC continua (Raydium/Metea).
# HFT_PUMPPORTAL=0 desliga. Requer Node >= 22 (usa o WebSocket global).
HFT_PUMPPORTAL=1
# Host alternativo do feed (teste/A-B). Vazio = wss://pumpportal.fun/api/data
PUMPPORTAL_WS_URL=
# RugCheck (API gratuita): evidência EXTERNA de risco no filtro profundo. Só pode ENDURECER a
# decisão; se estiver indisponível, é registrado como verificação faltante — nunca como aprovação.
# HFT_RUGCHECK=0 desliga. Teto de cota conservador (~5/min) em src/rateBudget.ts.
HFT_RUGCHECK=1
# Preço de mercado EM LOTE: 1 requisição por provedor por ciclo de gestão (DexScreener 30 tokens,
# Jupiter Price 50 ids, GeckoTerminal 30) em vez de 1 por posição. É o que permite escalar no
# plano gratuito sem 429 (com 10 posições, o modo por posição passa de 400 req/min).
# HFT_MARKET_BATCH=0 volta ao comportamento por posição (só para diagnóstico).
HFT_MARKET_BATCH=1

# -----------------------------------------------------------------------------
# QUALIDADE DE PREÇO (divergência entre fontes e liquidez)
# -----------------------------------------------------------------------------
# Divergência entre fontes INDEPENDENTES: compara cada preço usado com a amostra mais recente de
# OUTRA fonte e alerta quando discordam. Um preço divergente significa que uma das fontes está
# errada (pool raso, par errado, decimal trocado, cache velho) — exatamente o cenário em que um
# stop-loss vende por engano. É ALERTA: não dispara venda sozinho.
# HFT_PRICE_DIVERGENCE=0 desliga a comparação (NÃO usar com capital real).
HFT_PRICE_DIVERGENCE=1
# Faixas: warn a partir de 500 bps (5%) e critical a partir de 1500 bps (15%) de diferença
# relativa. Ajuste com MEDIÇÃO: token recém-lançado e fontes que leem pools diferentes discordam
# naturalmente em alguns por cento.
HFT_PRICE_DIVERGENCE_WARN_BPS=500
HFT_PRICE_DIVERGENCE_CRITICAL_BPS=1500
# Amostra mais velha que isto não serve de referência (evita tratar movimento de mercado como
# divergência). 1000–600000 ms.
HFT_PRICE_DIVERGENCE_MAX_AGE_MS=45000
# Quantos tokens por ciclo recebem SEGUNDA OPINIÃO de preço (rotativo; 0 desliga).
# Custo: no máximo 1 requisição extra por ciclo (Jupiter Price cobre até 50 ids).
HFT_PRICE_VERIFY_SAMPLE=2
# Preço de ENTRADA verificado: o preço de entrada é o denominador de todo o PnL da posição
# (stop, alvo, trailing e replay são percentuais dele). A entrada resolve o preço pela cascata
# gratuita e pede uma SEGUNDA opinião a outra fonte; se as duas discordarem além do limiar
# crítico, a entrada é RECUSADA (evidência de erro grosseiro, não de mercado em movimento).
# HFT_ENTRY_VERIFY=0 volta a aceitar a primeira fonte sem marcação (NÃO usar com capital real).
HFT_ENTRY_VERIFY=1
# Aceitar entrada com apenas UMA fonte? Padrão 1: numa API gratuita que pisca, recusar zeraria a
# coleta de dados — a posição fica MARCADA como não verificada. Para capital real, use 0 e exija
# duas fontes independentes.
HFT_ENTRY_ALLOW_SINGLE_SOURCE=1

# Liquidez em queda (DexScreener informa a liquidez no lote; o dado já foi pago em cota):
# alerta quando a liquidez cai X% do pico observado pelo bot. Remoção de LP é o padrão clássico
# de rug e antecede a queda do preço. ALERTA apenas — a saída automática por liquidez exige
# execução autorizada e regra validada em paper.
HFT_LIQUIDITY_WARN_DROP_PCT=50
HFT_LIQUIDITY_CRITICAL_DROP_PCT=80

# -----------------------------------------------------------------------------
# SEGURANÇA
# -----------------------------------------------------------------------------
# Token exigido no header `x-admin-token` para TODOS os POSTs (fechar posição,
# kill switch, submeter bundle, etc.).
#   - ausente em produção  -> todos os POSTs são NEGADOS (fail-closed)
#   - ausente em dev SEM chave real e sem modo LIVE -> permitido, com aviso no log
#   - ausente COM chave real ou modo LIVE -> NEGADO (503), independente de NODE_ENV
# Gere com: openssl rand -hex 32
ADMIN_TOKEN=

# Flag legada de execução real. NÃO é suficiente sozinha: exige RUNTIME_MODE=LIVE.
# NÃO ligue sem rodar `npm run verify:endpoints` com sucesso.
LIVE_TRADING_ENABLED=false

# Chave privada da hot wallet operacional. Formatos aceitos:
#   - array JSON de 64 bytes: [12,34,...]
#   - string base58
# RECOMENDADO: não usar esta variável em produção. Prefira KMS/HSM externo ou um
# signer isolado. Use SEMPRE uma hot wallet separada com capital limitado, nunca a
# carteira principal.
OPERATIONAL_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# LIMITES DE RISCO
# -----------------------------------------------------------------------------
# Tamanho máximo por operação, em SOL.
MAX_POSITION_SOL=0.1
# Teto do tip do Jito como fração do capital, em bps (50 bps = 0.5%).
# Sem este teto, um tip fixo de 0.003 SOL consome 300 bps de uma posição de 0.1 SOL.
MAX_TIP_BPS=50
# Idade máxima aceitável do preço (ms) antes de o gerenciador escalar alerta em vez
# de avaliar stop-loss com dado velho.
MAX_PRICE_AGE_MS=15000
# ── S12 — FREIOS POR RESULTADO (estavam no template e o código NUNCA os lia) ──────────────
# Config morta é pior do que config ausente: o operador acredita estar limitado sem estar.
# Teto de PERDA MEDIDA do dia (só PnL de ciclo completo, com as DUAS pernas e data legível;
# ganho não abate perda). Ao atingir, o KILL SWITCH é acionado: nenhuma entrada nova, saídas
# liberadas. 0/ausente = SEM TETO — o boot avisa em voz alta. No canário, 0.02 ≈ duas entradas.
MAX_DAILY_LOSS_SOL=0.02
# Máximo de posições REAIS abertas (paper não conta; posição não-provada CONTA, por conservadorismo).
MAX_OPEN_POSITIONS=1

# ── S12 — SAÍDA FAIL-CLOSED (a quantidade vem SEMPRE da cadeia) ───────────────────────────
# Sem leitura de saldo, a venda ABORTA sem assinar e a posição continua aberta: nada é estimado.
# HFT_EXIT_BALANCE_ATTEMPTS=3      # tentativas de leitura antes de abortar (1..5)
# HFT_EXIT_BALANCE_BACKOFF_MS=400  # espera entre tentativas (dobra a cada falha; piso 0)
# HFT_RESIDUAL_DUST_RAW=0          # resíduo tolerado para dar a saída como completa (unidades brutas)
# HFT_EXIT_ABORT_RECHECK_MS=60000  # intervalo mínimo entre rechecagens de saída abortada

# -----------------------------------------------------------------------------
# JITO
# -----------------------------------------------------------------------------
# Região do block engine: amsterdam | frankfurt | london | ny | slc | singapore | tokyo
# Escolha a de MENOR latência medida a partir do seu servidor, não a mais famosa.
JITO_REGION=ny

# -----------------------------------------------------------------------------
# MERCADO / DADOS
# -----------------------------------------------------------------------------
# Base URL do agregador. Os endpoints legados quote-api.jup.ag/v6 foram DESCONTINUADOS
# pela Jupiter. Host atual documentado: https://lite-api.jup.ag/swap/v1 (free) ou
# https://api.jup.ag/swap/v1 (requer API key).
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# -----------------------------------------------------------------------------
# JITO: TIP E STATUS DE LANDING
# -----------------------------------------------------------------------------
# Chave de autenticação do block engine (opcional). A doc do Jito diz que envios padrão NÃO
# exigem chave; com plano de limite próprio, informe o UUID aqui (vai no header x-jito-auth,
# nunca na URL — credencial em query string vaza em log de proxy).
JITO_UUID=

# Política de tip derivada do tip floor REAL (REST em bundles.jito.wtf — NÃO é método JSON-RPC
# do block engine, que é o host do block engine). Valores: p25 | p50 | p75 | p95 | p99 | ema50.
# Sem estes dados, o bot NÃO recomenda tip nenhum (não existe valor default inventado).
JITO_TIP_PERCENTILE=p75

# Teto do tip como fração do capital, em bps (50 bps = 0,5%). O teto VENCE sobre a política de
# percentil: se o resultado ficar abaixo do mínimo do Jito (1000 lamports), o bot avisa que o
# bundle provavelmente não será considerado, em vez de elevar o tip acima do limite de risco.
MAX_TIP_BPS=50

# ATENÇÃO — "Landed" NÃO é confirmação: significa que o bundle entrou em um bloco. A confirmação
# (nível confirmed/finalized) e o efeito esperado da transação precisam ser verificados no SEU
# RPC: GET /api/jito/bundle-status?ids=<bundleId>&signatures=<assinatura>.
# Rate limit documentado do Jito: 1 requisição/segundo/IP/região (o bot já aplica throttle).

# -----------------------------------------------------------------------------
# IDEMPOTÊNCIA E RECONCILIAÇÃO DE POSIÇÃO (S4)
# -----------------------------------------------------------------------------
# Intervalo entre reconciliações "posição local × carteira" (ms). Piso de 15000: cada
# ciclo custa 2 leituras de RPC (Token program e Token-2022), independentemente do
# número de posições. GET /api/positions/desync mostra o último resultado.
HFT_DESYNC_INTERVAL_MS=60000

# Idade mínima (ms) para uma posição poder ser considerada FANTASMA (aberta no banco,
# token ausente na carteira). Entrada recém-disparada pode não ter confirmado ainda;
# sem essa janela o bot acusaria de inexistente uma posição saudável.
HFT_DESYNC_MIN_AGE_MS=120000

# -----------------------------------------------------------------------------
# CAMINHO QUENTE (S5): ORÇAMENTO DO FILTRO PROFUNDO
# -----------------------------------------------------------------------------
# Orçamento (ms) para o filtro profundo de um sinal (holders/supply/rug check por RPC),
# medido POR SINAL — nunca como média. Ao estourar:
#   - LIVE .......... a entrada é VETADA (fail-closed: sem auditoria não se compra);
#   - PAPER/SHADOW .. prossegue marcado como NÃO AUDITADO (mede-se o custo do filtro sem
#                     arriscar capital).
# Se o filtro FALHAR (RPC/erro), a entrada é bloqueada em QUALQUER modo: sem nenhum dado,
# prosseguir não é "entrar sem auditar", é comprar às cegas. Contadores em
# GET /api/system-truth → hotPath. Calibre com o p95 medido em PAPER, não por palpite.
HFT_DEEP_FILTER_BUDGET_MS=900

# NOTA SOBRE IDEMPOTÊNCIA (nenhuma variável — comportamento fixo por segurança):
# reenviar os MESMOS bytes assinados é idempotente (a runtime deduplica por message hash);
# RECONSTRUIR a transação cria uma nova assinatura, e as duas podem entrar em bloco. Por
# isso o bot só reconstrói com prova de expiração (altura atual > lastValidBlockHeight,
# lido de um RPC saudável) ou com erro de execução reportado pela cadeia. As intenções
# ficam em GET /api/execution-intents; os bytes assinados NUNCA são gravados em disco.

# -----------------------------------------------------------------------------
# ENTRADA EM SHADOW (validação de construibilidade — nunca assina nada)
# -----------------------------------------------------------------------------
# Quando um sinal é APROVADO pelo risk engine, o bot pede cotação real, monta a transação e
# roda `simulateTransaction` no RPC — sem assinar e sem enviar. Isto responde "a rota existe?
# a transação é montável? o compute cabe?" antes de qualquer capital.
# Slippage usado na cotação de validação (bps). 300 = 3%. É o MESMO parâmetro que a execução
# real usaria; um valor irreal aqui produz uma validação otimista.
SHADOW_SLIPPAGE_BPS=300
# O resultado fica em GET /api/shadow-entries e em data/events.jsonl (kind: shadow-entry).
# LEMBRETE: simulação bem-sucedida NÃO garante execução — o estado muda entre simular e enviar.

# -----------------------------------------------------------------------------
# IA (opcional — apenas enriquecimento de texto na auditoria)
# -----------------------------------------------------------------------------
# Importante: a IA NÃO substitui verificação on-chain. No código atual ela não pode
# elevar o score de risco acima do teto imposto por dados ausentes (fail-closed).
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# PERSISTÊNCIA (S10) — JSON local (default) ou Postgres espelhado
# -----------------------------------------------------------------------------
# O JSON continua sendo escrito SEMPRE: o banco é espelho, não substituição. Banco fora do ar
# degrada a durabilidade e o voo único entre processos, mas NÃO apaga o histórico local.
# json     = comportamento original: voo único POR PROCESSO e no máximo 50 trades no arquivo.
# postgres = voo único ENTRE PROCESSOS (claim atômico com TTL) + histórico durável espelhado.
# ATENÇÃO: com "postgres", o boot ABORTA (exit 1) se o banco estiver inacessível ou o schema
# estiver atrás — de propósito. Sem o árbitro entre processos, assinar seria assinar confiando
# numa proteção que não existe.
HFT_STORAGE=json
# Connection string do banco. NUNCA comite este valor. Tiers gratuitos servem: Neon, Supabase,
# Railway. Exemplo local (Postgres do provedor ou contêiner):
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=
# Por quanto tempo um claim de voo único vale antes de ser considerado órfão (ms). Piso 5000.
# TTL curto demais permite dois processos em sequência; longo demais atrasa a retomada após crash.
HFT_STORAGE_CLAIM_TTL_MS=300000
# Teto de espera pela resposta do claim (ms). Estourou = RECUSA (banco lento ≠ mint livre).
HFT_STORAGE_CLAIM_TIMEOUT_MS=1500
# Quais logs de decisão sobem para o banco: critical (só WARN/ERROR/CRITICAL), all, off.
HFT_STORAGE_MIRROR_LOGS=critical
# Quantos trades a leitura de histórico traz para a validação (S9). Teto de 1000000.
HFT_STORAGE_HISTORY_LIMIT=5000
# Comandos: npm run storage:migrate | storage:check | storage:selftest

# -----------------------------------------------------------------------------
# CONTABILIDADE (S11) — o PnL é do CICLO (entrada + saída), medido nas duas transações
# -----------------------------------------------------------------------------
# A perna de entrada é medida e gravada na posição automaticamente na confirmação da compra; sem
# ela, a saída NÃO apura PnL (declara "exit_leg_only" e reporta só a receita da venda). Não há nada
# a configurar.
# Conferência extra (opcional) por janela de saldo: além de comparar as duas pernas, chama
# getBalance antes/depois da saída para detectar movimentação de SOL fora do ciclo. Custa 1 RTT no
# caminho da saída — com 0, o sistema já confere a janela de graça, usando os saldos das próprias
# transações (pre(saída) − post(entrada)).
HFT_PNL_WINDOW_CHECK=0

# -----------------------------------------------------------------------------
# RECONCILIAÇÃO (S14) — fechar o ciclo de registros antigos (só LEITURA da cadeia)
# -----------------------------------------------------------------------------
# Tolerância (SOL) na conferência entre o valor da venda REGISTRADO e a LEITURA RELIDA da cadeia
# ao reconciliar. Divergência acima disto recusa a promoção do registro (fail-closed).
# Default 0.000005 SOL = 5.000 lamports: o mesmo epsilon já usado na conferência de janela do S11.
# Não é preço nem limite de perda — é o quanto duas leituras da MESMA transação podem divergir
# sem indicar que o saldo foi mexido por fora do ciclo.
HFT_RECONCILE_TOLERANCE_SOL=0.000005

# -----------------------------------------------------------------------------
# CUSTO DA VOLTA EM PAPER (A) — o piso que a sombra passa a DESCONTAR
# -----------------------------------------------------------------------------
# O fechamento em sombra calculava o resultado só pelo movimento de PREÇO (custo zero). Agora ele
# desconta o piso de custo do ciclo (fee base nas duas pernas + tip nas duas + priority fee), com
# premissas de slippage/AMM DECLARADAS. `npm run cost:roundtrip` mostra a conta e
# GET /api/system-truth → roundTripCost expõe o piso efetivo. Nada aqui é medido: sem execução real
# não existe fill para medir slippage.
#
# PRIORITY FEE: sem declarar, o piso é um LIMITE INFERIOR (o custo real é >= ao mostrado). Declare o
# valor que você realmente paga no provedor para o piso deixar de ser limite inferior.
# HFT_PRIORITY_FEE_MICROLAMPORTS=100000
#
# Slippage assumido por perna (bps). Default: o mesmo parâmetro da validação de sombra (300 = 3%).
# HFT_PAPER_SLIPPAGE_BPS=300
#
# Fee de rota/AMM assumida (bps do capital). Premissa declarada — não é medição.
# HFT_PAPER_AMM_FEE_BPS=25
#
