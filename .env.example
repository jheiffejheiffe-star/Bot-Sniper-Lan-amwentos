# =============================================================================
# Bot Sniper Solana — variáveis de ambiente
#
# ATENÇÃO: nenhum segredo deve ser commitado. Este arquivo é apenas o TEMPLATE.
# Copie para `.env` (que deve estar no .gitignore) e preencha.
#
# REGRA DE OURO: comece SEMPRE com RUNTIME_MODE=PAPER (ou ausente) e
# LIVE_TRADING_ENABLED ausente/false.
#
# MODOS DE EXECUÇÃO (RUNTIME_MODE) — definem quem pode assinar transação:
#   SIMULATION  dados sintéticos (ÚNICO modo onde RNG é legítimo). Nunca assina.
#   PAPER       dados reais, contabilidade modelada. Nunca assina. (default)
#   SHADOW      dados reais, constrói e SIMULA a transação, nunca assina.
#   LIVE        único modo autorizado a assinar/enviar.
#
# LIVE exige DUAS declarações: RUNTIME_MODE=LIVE **e** LIVE_TRADING_ENABLED=true.
#   - RUNTIME_MODE=LIVE sem a flag  -> rebaixado para SHADOW (não assina).
#   - LIVE_TRADING_ENABLED=true sem RUNTIME_MODE -> ERRO FATAL NO BOOT (não sobe ambíguo).
# Em LIVE, o boot também exige OPERATIONAL_PRIVATE_KEY, ADMIN_TOKEN e RPC_ENDPOINT https.
# =============================================================================

# -----------------------------------------------------------------------------
# MODO DE EXECUÇÃO
# -----------------------------------------------------------------------------
# Valores: SIMULATION | PAPER | SHADOW | LIVE. Ausente = PAPER.
RUNTIME_MODE=PAPER

# Host de bind do servidor HTTP. Ausente = 127.0.0.1 (loopback).
# Expor na rede é decisão explícita: com chave real presente, o boot passa a exigir
# ADMIN_TOKEN quando este valor NÃO for loopback.
HFT_BIND_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# REDE / RPC  (obrigatório para operar)
# -----------------------------------------------------------------------------
# RPC dedicado. NÃO use https://api.mainnet-beta.solana.com para trading:
# é rate-limited agressivamente, não garante envio e não tem suporte.
RPC_ENDPOINT=
# WebSocket correspondente (wss://...). Sem ele, não há detecção de lançamentos.
RPC_WEBSOCKET=
# Backups separados por vírgula (failover). Ex.: https://b.example.com,https://c.example.com
RPC_FALLBACKS=
# Rótulos exibidos no painel de infraestrutura (opcionais).
RPC_PRIMARY_LABEL=
RPC_PRIMARY_REGION=

# Grafo de ingestão gRPC (Yellowstone). Se vazio, cai para WebSocket RPC, que tem
# latência maior. OBS.: o cliente protobuf gRPC ainda NÃO está implementado neste
# código — configurar aqui hoje apenas registra um aviso no boot.
GEYSER_GRPC_URL=

# -----------------------------------------------------------------------------
# SEGURANÇA
# -----------------------------------------------------------------------------
# Token exigido no header `x-admin-token` para TODOS os POSTs (fechar posição,
# kill switch, submeter bundle, etc.).
#   - ausente em produção  -> todos os POSTs são NEGADOS (fail-closed)
#   - ausente em dev SEM chave real e sem modo LIVE -> permitido, com aviso no log
#   - ausente COM chave real ou modo LIVE -> NEGADO (503), independente de NODE_ENV
# Gere com: openssl rand -hex 32
ADMIN_TOKEN=

# Flag legada de execução real. NÃO é suficiente sozinha: exige RUNTIME_MODE=LIVE.
# NÃO ligue sem rodar `npm run verify:endpoints` com sucesso.
LIVE_TRADING_ENABLED=false

# Chave privada da hot wallet operacional. Formatos aceitos:
#   - array JSON de 64 bytes: [12,34,...]
#   - string base58
# RECOMENDADO: não usar esta variável em produção. Prefira KMS/HSM externo ou um
# signer isolado. Use SEMPRE uma hot wallet separada com capital limitado, nunca a
# carteira principal.
OPERATIONAL_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# LIMITES DE RISCO
# -----------------------------------------------------------------------------
# Tamanho máximo por operação, em SOL.
MAX_POSITION_SOL=0.1
# Teto do tip do Jito como fração do capital, em bps (50 bps = 0.5%).
# Sem este teto, um tip fixo de 0.003 SOL consome 300 bps de uma posição de 0.1 SOL.
MAX_TIP_BPS=50
# Idade máxima aceitável do preço (ms) antes de o gerenciador escalar alerta em vez
# de avaliar stop-loss com dado velho.
MAX_PRICE_AGE_MS=15000
# Limite diário de perda, em SOL (0 = não configurado).
MAX_DAILY_LOSS_SOL=0
# Número máximo de operações abertas simultaneamente.
MAX_OPEN_POSITIONS=1

# -----------------------------------------------------------------------------
# JITO
# -----------------------------------------------------------------------------
# Região do block engine: amsterdam | frankfurt | london | ny | slc | singapore | tokyo
# Escolha a de MENOR latência medida a partir do seu servidor, não a mais famosa.
JITO_REGION=ny

# -----------------------------------------------------------------------------
# MERCADO / DADOS
# -----------------------------------------------------------------------------
# Base URL do agregador. Os endpoints legados quote-api.jup.ag/v6 foram DESCONTINUADOS
# pela Jupiter. Host atual documentado: https://lite-api.jup.ag/swap/v1 (free) ou
# https://api.jup.ag/swap/v1 (requer API key).
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# -----------------------------------------------------------------------------
# JITO: TIP E STATUS DE LANDING
# -----------------------------------------------------------------------------
# Chave de autenticação do block engine (opcional). A doc do Jito diz que envios padrão NÃO
# exigem chave; com plano de limite próprio, informe o UUID aqui (vai no header x-jito-auth,
# nunca na URL — credencial em query string vaza em log de proxy).
JITO_UUID=

# Política de tip derivada do tip floor REAL (REST em bundles.jito.wtf — NÃO é método JSON-RPC
# do block engine, que é o host do block engine). Valores: p25 | p50 | p75 | p95 | p99 | ema50.
# Sem estes dados, o bot NÃO recomenda tip nenhum (não existe valor default inventado).
JITO_TIP_PERCENTILE=p75

# Teto do tip como fração do capital, em bps (50 bps = 0,5%). O teto VENCE sobre a política de
# percentil: se o resultado ficar abaixo do mínimo do Jito (1000 lamports), o bot avisa que o
# bundle provavelmente não será considerado, em vez de elevar o tip acima do limite de risco.
MAX_TIP_BPS=50

# ATENÇÃO — "Landed" NÃO é confirmação: significa que o bundle entrou em um bloco. A confirmação
# (nível confirmed/finalized) e o efeito esperado da transação precisam ser verificados no SEU
# RPC: GET /api/jito/bundle-status?ids=<bundleId>&signatures=<assinatura>.
# Rate limit documentado do Jito: 1 requisição/segundo/IP/região (o bot já aplica throttle).

# -----------------------------------------------------------------------------
# ENTRADA EM SHADOW (validação de construibilidade — nunca assina nada)
# -----------------------------------------------------------------------------
# Quando um sinal é APROVADO pelo risk engine, o bot pede cotação real, monta a transação e
# roda `simulateTransaction` no RPC — sem assinar e sem enviar. Isto responde "a rota existe?
# a transação é montável? o compute cabe?" antes de qualquer capital.
# Slippage usado na cotação de validação (bps). 300 = 3%. É o MESMO parâmetro que a execução
# real usaria; um valor irreal aqui produz uma validação otimista.
SHADOW_SLIPPAGE_BPS=300
# O resultado fica em GET /api/shadow-entries e em data/events.jsonl (kind: shadow-entry).
# LEMBRETE: simulação bem-sucedida NÃO garante execução — o estado muda entre simular e enviar.

# -----------------------------------------------------------------------------
# IA (opcional — apenas enriquecimento de texto na auditoria)
# -----------------------------------------------------------------------------
# Importante: a IA NÃO substitui verificação on-chain. No código atual ela não pode
# elevar o score de risco acima do teto imposto por dados ausentes (fail-closed).
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# INFRA
# -----------------------------------------------------------------------------
NODE_ENV=development
# Porta HTTP interna (o app também lê PORT para Cloud Run).
PORT=3000
