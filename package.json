{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/safety.test.ts",
    "test:all": "npm run lint && npm run test",
    "verify:endpoints": "tsx scripts/verify-endpoints.ts",
    "pump:dryrun": "tsx scripts/pump-dryrun.ts",
    "grpc:check": "tsx scripts/grpc-check.ts",
    "test:destructive": "tsx test-production.ts",
    "replay": "tsx scripts/replay.ts",
    "quarantine": "tsx scripts/quarantine-db.ts",
    "smoke": "tsx scripts/smoke.ts",
    "free:check": "tsx scripts/free-check.ts",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "storage:check": "tsx scripts/storage-migrate.ts --check",
    "storage:selftest": "tsx scripts/storage-selftest.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@triton-one/yellowstone-grpc": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tweetnacl": "^1.0.3",
    "vite": "^6.2.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
